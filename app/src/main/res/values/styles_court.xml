<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CourtText" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/court_ink</item>
        <item name="android:fontFamily">@font/font_court_body</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CourtText.Display">
        <item name="android:fontFamily">@font/font_court_display</item>
        <item name="android:textSize">@dimen/court_title_size</item>
        <item name="android:textColor">@color/court_ink</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="CourtText.Brand">
        <item name="android:fontFamily">@font/font_court_body</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/court_primary</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CourtText.Body">
        <item name="android:textSize">@dimen/court_body_size</item>
        <item name="android:textColor">@color/court_ink</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="CourtText.Meta">
        <item name="android:fontFamily">@font/literata_semibold</item>
        <item name="android:textSize">@dimen/court_meta_size</item>
        <item name="android:textColor">@color/court_ink_hint</item>
    </style>

    <style name="CourtText.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/court_ink_tertiary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="CourtText.Action">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/court_primary</item>
        <item name="android:fontFamily">@font/font_court_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CourtButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_court_button_primary</item>
        <item name="android:textColor">@color/court_surface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/font_court_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="CourtButton.Ghost">
        <item name="android:background">@drawable/bg_court_button_ghost</item>
        <item name="android:textColor">@color/court_primary</item>
    </style>

    <style name="CourtTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/font_court_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="CourtTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabIndicatorColor">@color/court_primary</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabSelectedTextColor">@color/court_primary</item>
        <item name="tabTextColor">@color/court_ink_hint</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabTextAppearance">@style/CourtTabText</item>
        <item name="tabPaddingStart">12dp</item>
        <item name="tabPaddingEnd">12dp</item>
    </style>
</resources>
