<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/court_paper"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        style="@style/CourtTabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/court_nav_height"
        android:background="@drawable/bg_court_nav"
        android:contentDescription="@string/description_navigation_main"
        android:elevation="0dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        app:tabGravity="fill"
        app:tabIconTint="@color/court_primary"
        app:tabIndicatorHeight="2dp"
        app:tabIndicatorColor="@color/court_primary"
        app:tabInlineLabel="true"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent" />

</LinearLayout>
