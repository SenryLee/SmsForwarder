<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_court_card"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/iv_rule_image"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_app"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <ImageView
                android:id="@+id/iv_rule_status"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stop"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_rule_match"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/CourtText.Body"
                android:textSize="15sp"
                tools:text="法院号码·12368" />

            <LinearLayout
                android:id="@+id/layout_Senders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_edit"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_court_header_action"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit"
                app:tint="@color/court_seal"
                tools:ignore="ContentDescription,PrivateResource,ImageContrastCheck" />

            <ImageView
                android:id="@+id/iv_copy"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_court_header_action"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy"
                app:tint="@color/court_ink_secondary"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <ImageView
                android:id="@+id/iv_delete"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_court_header_action"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_delete"
                app:tint="@color/court_danger"
                tools:ignore="ContentDescription,PrivateResource" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
